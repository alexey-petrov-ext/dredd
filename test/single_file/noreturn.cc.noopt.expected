// DREDD PRELUDE START
// If this has been inserted at an inappropriate place in a source file,
// declare a placeholder function with the following signature to
// mandate where the prelude should be placed:
//
// void __dredd_prelude_start();
//
#include <atomic>
#include <cinttypes>
#include <cstddef>
#include <cstdlib>
#include <fstream>
#include <sstream>


namespace {
template <typename Result>
class __dredd_lazy {
 public:
  template <typename Callable>
  __dredd_lazy(const Callable& callable)
      : callable_(&callable),
        invoke_([](const void* target) -> Result {
          return (*static_cast<const Callable*>(target))();
        }) {}
  Result operator()() const { return invoke_(callable_); }

 private:
  const void* callable_;
  Result (*invoke_)(const void*);
};
}  // namespace

#ifdef _MSC_VER
#define __dredd_thread_local __declspec(thread)
#elif __APPLE__
#define __dredd_thread_local __thread
#else
#define __dredd_thread_local thread_local
#endif

static __dredd_thread_local bool __dredd_some_mutation_enabled = true;
static bool __dredd_enabled_mutation(int local_mutation_id) {
  static __dredd_thread_local bool initialized = false;
  static __dredd_thread_local uint64_t enabled_bitset[1];
  if (!initialized) {
    bool some_mutation_enabled = false;
    const char* dredd_environment_variable = std::getenv("DREDD_ENABLED_MUTATION");
    if (dredd_environment_variable != nullptr) {
      const char* token = dredd_environment_variable;
      while (*token != '\0') {
        if (*token == ',') {
          token++;
          continue;
        }
        char* end = nullptr;
        long value = std::strtol(token, &end, 10);
        if (end == token) {
          std::abort();
        }
        if (value >= 0 && value < 2) {
          int local_value = static_cast<int>(value - 0);
          enabled_bitset[local_value / 64] |= (static_cast<uint64_t>(1) << (local_value % 64));
          some_mutation_enabled = true;
        }
        token = end;
        while (*token != ',' && *token != '\0') {
          token++;
        }
      }
    }
    initialized = true;
    __dredd_some_mutation_enabled = some_mutation_enabled;
  }
  return (enabled_bitset[local_mutation_id / 64] & (static_cast<uint64_t>(1) << (local_mutation_id % 64))) != 0;
}

#include <cstdlib>
#include <iostream>

[[noreturn]] static int foo() {
  if (!__dredd_enabled_mutation(0)) { std::cout << "Aborting\n"; }
  if (!__dredd_enabled_mutation(1)) { std::abort(); }
}
