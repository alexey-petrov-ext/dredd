          int local_value = static_cast<int>(value - 0);
          enabled_bitset[local_value / 64] |= (static_cast<uint64_t>(1) << (local_value % 64));
          some_mutation_enabled = true;
        }
        token = end;
        while (*token != ',' && *token != '\0') {
